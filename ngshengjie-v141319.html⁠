<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>📈 股票關卡計算機 V43｜進階交易版</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#f2f6fa;color:#18263a;font-family:-apple-system,BlinkMacSystemFont,"PingFang TC","Noto Sans TC",sans-serif}.wrap{max-width:900px;margin:auto;padding:12px}.title{text-align:center;font-size:28px;font-weight:950;margin:12px 0 4px}.sub{text-align:center;color:#687486;line-height:1.6;font-size:14px;margin-bottom:14px}.card{background:#fff;border-radius:26px;padding:18px;margin:14px 0;box-shadow:0 7px 24px rgba(35,55,80,.08)}h2{font-size:22px;margin:0 0 14px;font-weight:950}label{display:block;font-weight:850;margin:9px 0 6px}input,select{width:100%;height:54px;border:0;border-radius:17px;background:#f0f4f8;padding:10px 14px;font-size:18px;outline:0;color:#18263a}.grid2,.basic{display:grid;grid-template-columns:1fr 1fr;gap:10px}.search{display:grid;grid-template-columns:1fr 110px;gap:10px}.tabs{display:grid;grid-template-columns:repeat(5,1fr);gap:7px;margin-bottom:10px}.tab,button{border:0;border-radius:17px;min-height:54px;padding:10px 14px;font-size:17px;font-weight:900;cursor:pointer}.tab{background:#edf1f6}.tab.active,.black{background:#202020;color:#fff}.purple{background:linear-gradient(90deg,#5c5ff2,#a64cf0);color:#fff}.status,.note{margin-top:11px;padding:13px 15px;border-radius:15px;background:#f1f3f5;font-weight:800;line-height:1.6}.ok{background:#e7f8ed;color:#14652f}.warn{background:#fff5d8;color:#755500}.err{background:#ffe8e8;color:#9e0000}.box{background:#f1f4f8;border-radius:17px;padding:13px;min-height:78px}.box span{display:block;color:#87919c;font-size:13px}.box b{display:block;font-size:20px;margin-top:6px;word-break:break-word}.up{color:#b00000}.down{color:#087f3b}.hidden{display:none}.scan{display:grid;grid-template-columns:1fr 1fr;gap:10px}.scan button{font-size:19px}.green{background:#e8f9ed}.yellow{background:#fff4d2}.red{background:#ffe8e8}.blue{background:#e9f1ff}.result{background:#f1f4f8;border-radius:17px;padding:13px;margin-top:9px}.result b{font-size:18px}.rabbit-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.rabbit{border-radius:21px;padding:16px;min-height:150px}.rabbit strong{font-size:30px;display:block;margin:7px 0}.start{width:100%;font-size:23px;min-height:65px}.small{font-size:13px;color:#74808d;line-height:1.7}.plan{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.bigjudge{text-align:center;border-radius:22px;padding:18px;font-size:26px;font-weight:950}.portfolio{display:grid;gap:9px;margin-top:10px}.pitem{display:grid;grid-template-columns:1fr auto;align-items:center;background:#f1f4f8;border-radius:17px;padding:12px}.danger{background:#ffe7e7;color:#a40000}@media(max-width:600px){.wrap{padding:9px}.card{padding:15px}.title{font-size:24px}.tabs{grid-template-columns:repeat(3,1fr)}.tabs button{font-size:14px}.grid2,.basic,.scan,.rabbit-grid,.plan{grid-template-columns:1fr}.search{grid-template-columns:1fr 100px}}
</style>
</head>
<body>
<div class="wrap">
<div class="title">📈 股票關卡計算機 V43</div>
<div class="sub">🇹🇼 台股／ETF｜🇺🇸 美股｜🇭🇰 港股｜🇯🇵 日股｜🇰🇷 韓股<br>📈 5／20／60／120／240日線｜🔥 起漲突破｜🎯 風險報酬｜🐰 仙兔關卡</div>

<div class="card">
<h2>🔎 股票搜尋</h2>
<div class="tabs">
<button id="tw" class="tab active" onclick="setM('TW')">🇹🇼 台股</button>
<button id="us" class="tab" onclick="setM('US')">🇺🇸 美股</button>
<button id="hk" class="tab" onclick="setM('HK')">🇭🇰 港股</button>
<button id="jp" class="tab" onclick="setM('JP')">🇯🇵 日股</button>
<button id="kr" class="tab" onclick="setM('KR')">🇰🇷 韓股</button>
</div>
<div class="search"><input id="q" placeholder="2330、0050、台積電"><button class="black" onclick="search()">搜尋</button></div>
<div id="status" class="status">尚未查詢</div>
</div>

<div class="card">
<h2>📊 行情</h2>
<div class="basic">
<div class="box"><span>代號</span><b id="code">--</b></div><div class="box"><span>名稱</span><b id="nm">--</b></div>
<div class="box"><span>現價</span><b id="price">--</b></div><div class="box"><span>昨收</span><b id="prev">--</b></div>
<div class="box"><span>📈 漲跌</span><b id="chg">--</b></div><div class="box"><span>📊 漲跌幅</span><b id="pct">--</b></div>
<div class="box"><span>開盤</span><b id="open">--</b></div><div class="box"><span>最高</span><b id="high">--</b></div>
<div class="box"><span>最低</span><b id="low">--</b></div><div class="box"><span>成交量</span><b id="vol">--</b></div>
<div class="box"><span>5日線</span><b id="ma5">--</b></div><div class="box"><span>20日線</span><b id="ma20">--</b></div>
<div class="box"><span>60日線</span><b id="ma60">--</b></div><div class="box"><span>120日線</span><b id="ma120">--</b></div>
<div class="box"><span>240日線</span><b id="ma240">--</b></div>
</div>
<div id="trend" class="status">搜尋後自動判斷。</div>
</div>

<div class="card">
<h2>🔥 熱門／起漲突破</h2>
<div class="scan">
<button class="green" onclick="scan('break')">🚀 起漲突破</button>
<button class="yellow" onclick="scan('strong')">🔥 強勢股</button>
<button class="blue" onclick="scan('watch')">🟡 觀察突破</button>
<button class="black" onclick="scan('all')">📊 熱門總覽</button>
</div>
<div id="scanStatus" class="status">點選上方按鈕開始掃描。</div>
<div id="results"></div>
</div>

<div class="card">
<h2>🐰 仙兔關卡</h2>
<div class="grid2">
<div><label>現價</label><input id="cp" type="number" step="0.01"></div>
<div><label>主力／外資成本</label><input id="cost" type="number" step="0.01"></div>
<div><label>營收飆漲目標</label><input id="target" type="number" step="0.01"></div>
<div><label>單筆可承受風險 %</label><input id="risk" type="number" value="3" step="0.1"></div>
</div>
<div id="levels" class="rabbit-grid"></div>
</div>

<div class="card">
<h2>🎯 交易計畫</h2>
<div class="grid2">
<div><label>實際成本</label><input id="mycost" type="number" step="0.01"></div>
<div><label>股數</label><input id="shares" type="number" step="1"></div>
</div>
<div class="plan" style="margin-top:10px">
<div class="box"><span>第一止盈</span><b id="tp1">--</b></div><div class="box"><span>第二止盈</span><b id="tp2">--</b></div><div class="box"><span>第三止盈</span><b id="tp3">--</b></div>
<div class="box"><span>第一止損</span><b id="sl1">--</b></div><div class="box"><span>第二止損</span><b id="sl2">--</b></div><div class="box"><span>第三止損</span><b id="sl3">--</b></div>
</div>
<button class="purple start" style="margin-top:12px" onclick="calculate()">🚀 開始計算交易計畫</button>
<div id="judge" class="bigjudge" style="margin-top:12px;background:#f1f4f8">等待資料</div>
<div class="grid2" style="margin-top:10px">
<div class="box"><span>第一進場區</span><b id="entry">--</b></div>
<div class="box"><span>突破關卡</span><b id="break">--</b></div>
<div class="box"><span>風險</span><b id="riskShow">--</b></div>
<div class="box"><span>第一目標報酬</span><b id="reward">--</b></div>
<div class="box"><span>風險報酬比</span><b id="rr">--</b></div>
<div class="box"><span>目前損益</span><b id="pnl">--</b></div>
</div>
<div id="scenario" class="status">A／B／C 三劇本會依價格與均線自動判斷。</div>
</div>

<div class="card">
<h2>💾 我的股票</h2>
<button class="black" onclick="save()">＋ 儲存目前股票</button>
<button class="danger" style="margin-left:6px" onclick="clearAll()">清除全部</button>
<div id="portfolio" class="portfolio"></div>
</div>

<div class="card"><div class="small">V43 以「先試單、再確認、再增加；錯誤先控制、正確讓利潤跑」為核心。所有判斷均為規則化參考，不保證獲利，也不構成投資建議。</div></div>
</div>

<script>
const API="https://api.finmindtrade.com/api/v4/data",Y="https://query1.finance.yahoo.com/v8/finance/chart/",TW="https://openapi.twse.com.tw/v1/exchangeReport/STOCK_DAY_ALL";
const $=id=>document.getElementById(id),num=x=>{let n=parseFloat(String(x??"").replace(/,/g,""));return Number.isFinite(n)?n:null},fmt=x=>x==null?"--":Number(x).toLocaleString("zh-TW",{maximumFractionDigits:2}),ds=d=>d.toISOString().slice(0,10),ago=n=>{let d=new Date();d.setDate(d.getDate()-n);return d};
let market="TW",cur={code:"",name:"",currency:"TWD"};
const lists={TW:[["2330","台積電"],["2454","聯發科"],["2317","鴻海"],["2382","廣達"],["2308","台達電"],["2367","燿華"],["1519","華城"],["3017","奇鋐"],["3324","雙鴻"],["3231","緯創"],["6669","緯穎"],["0050","元大台灣50"]],US:[["NVDA","NVIDIA"],["AAPL","Apple"],["MSFT","Microsoft"],["AMZN","Amazon"],["META","Meta"],["TSLA","Tesla"],["AMD","AMD"],["AVGO","Broadcom"],["MU","Micron"]],HK:[["0700","騰訊"],["9988","阿里巴巴"],["1810","小米"],["3690","美團"],["9618","京東"],["0388","港交所"]],JP:[["7203","豐田"],["6758","Sony"],["9984","軟銀"],["6861","Keyence"],["8035","東京威力科創"],["6501","日立"]],KR:[["005930","三星電子"],["000660","SK海力士"],["373220","LG新能源"],["005380","現代汽車"],["000270","起亞"],["035420","NAVER"]]};
function setM(m){market=m;["TW","US","HK","JP","KR"].forEach(x=>$(x.toLowerCase()).classList.toggle("active",x===m));$("q").placeholder={TW:"2330、0050、台積電",US:"NVDA、AAPL、TSLA",HK:"0700、9988、1810",JP:"7203、6758、9984",KR:"005930、000660、035420"}[m];$("status").textContent="目前市場："+m}
async function get(url){let r=await fetch(url,{cache:"no-store"});if(!r.ok)throw Error("HTTP "+r.status);return r.json()}
async function fin(dataset,p){let j=await get(API+"?"+new URLSearchParams({dataset,...p}));if(!j.data)throw Error("資料來源無資料");return j.data}
function setHeader(c,n){$("code").textContent=c;$("nm").textContent=n;cur.code=c;cur.name=n}
async function search(){let q=$("q").value.trim();if(!q){$("status").textContent="請輸入股票代號或名稱";return}$("status").textContent="⏳ 查詢中…";try{if(market==="TW")await twSearch(q);else{let c=q.toUpperCase().replace(/\.HK|\.T|\.KS/gi,""),t=market==="US"?c:market==="HK"?c.padStart(4,"0")+"."+("HK"):market==="JP"?c+".T":c+".KS";cur={code:c,name:c,currency:market==="US"?"USD":market==="HK"?"HKD":market==="JP"?"JPY":"KRW"};setHeader(c,c);await yahoo(t)}finish();$("status").className="status ok";$("status").textContent="🟢 查詢完成"}catch(e){$("status").className="status err";$("status").textContent="查詢失敗："+e.message}}
async function twSearch(q){let c=q,n=q;if(!/^\d{4,6}$/.test(q)){let a=await fin("TaiwanStockInfo",{}),h=a.find(x=>String(x.stock_name||"").includes(q));if(!h)throw Error("找不到台股，請輸入代號");c=String(h.stock_id);n=String(h.stock_name)}else{try{let a=await fin("TaiwanStockInfo",{}),h=a.find(x=>String(x.stock_id)===c);if(h)n=h.stock_name}catch(e){}}cur={code:c,name:n,currency:"TWD"};setHeader(c,n);let rows=[];try{rows=await fin("TaiwanStockPrice",{data_id:c,start_date:ds(ago(500)),end_date:ds(new Date())})}catch(e){}if(rows.length){rows.sort((a,b)=>String(a.date).localeCompare(String(b.date)));let r=rows.at(-1),cl=rows.map(x=>num(x.close)).filter(x=>x!=null);show(r.date,num(r.close),rows.length>1?num(rows.at(-2).close):null,num(r.open),num(r.max),num(r.min),num(r.Trading_Volume),cl)}else{let a=await get(TW),r=a.find(x=>String(x.Code)===c);if(!r)throw Error("台股行情無法取得");show(r.Date,num(r.ClosingPrice),num(r.ClosingPrice)-num(r.Change),num(r.OpeningPrice),num(r.HighestPrice),num(r.LowestPrice),num(r.TradeVolume),[])}}
async function yahoo(t){let j=await get(Y+encodeURIComponent(t)+"?period1="+Math.floor(ago(500).getTime()/1000)+"&period2="+Math.floor(Date.now()/1000+86400)+"&interval=1d"),r=j.chart?.result?.[0];if(!r)throw Error("Yahoo 無資料");let q=r.indicators.quote[0],rows=[];for(let i=0;i<r.timestamp.length;i++)if(q.close[i]!=null)rows.push({date:new Date(r.timestamp[i]*1000).toISOString().slice(0,10),c:num(q.close[i]),o:num(q.open?.[i]),h:num(q.high?.[i]),l:num(q.low?.[i]),v:num(q.volume?.[i])});let x=rows.at(-1),p=rows.length>1?rows.at(-2).c:null;show(x.date,x.c,p,x.o,x.h,x.l,x.v,rows.map(x=>x.c))}
function avg(a,n){return a.length>=n?a.slice(-n).reduce((s,x)=>s+x,0)/n:null}
function show(date,p,prev,o,h,l,v,cl){$("price").textContent=fmt(p);$("prev").textContent=fmt(prev);$("open").textContent=fmt(o);$("high").textContent=fmt(h);$("low").textContent=fmt(l);$("vol").textContent=fmt(v);$("ma5").textContent=fmt(avg(cl,5));$("ma20").textContent=fmt(avg(cl,20));$("ma60").textContent=fmt(avg(cl,60));$("ma120").textContent=fmt(avg(cl,120));$("ma240").textContent=fmt(avg(cl,240));let d=prev==null?null:p-prev,pc=prev?d/prev*100:null;$("chg").textContent=d==null?"--":(d>0?"+":"")+fmt(d);$("pct").textContent=pc==null?"--":(pc>0?"+":"")+fmt(pc)+"%";$("chg").className=pc>0?"up":pc<0?"down":"";$("pct").className=pc>0?"up":pc<0?"down":"";trend()}
function finish(){$("cp").value=num($("price").textContent)||"";trend()}
function trend(){let p=num($("price").textContent),ms=[5,20,60,120,240].map(n=>[n,num($("ma"+n).textContent)]);if(p==null)return;let a=ms.filter(x=>x[1]!=null&&p>=x[1]).length;$("trend").innerHTML="現價 <b>"+fmt(p)+"</b>｜"+ms.map(x=>x[1]==null?x[0]+"日線缺資料":p>=x[1]?"🟢"+x[0]+"日線":"🔴"+x[0]+"日線").join("｜")+"<br>"+(a>=4?"🔥 多線強勢":a>=2?"🟡 中性觀察":"🔴 偏弱")}
function calculate(){let p=num($("cp").value),c=num($("cost").value),t=num($("target").value),risk=(num($("risk").value)||3)/100;if(!p||!c){$("judge").textContent="請先輸入現價與成本";return}let entry=Math.min(p,c*1.03),sl=c*(1-risk),tp1=c*1.05,tp2=c*1.1,tp3=c*1.15,br=Math.max(c*1.08,num($("ma20").textContent)||c,num($("ma60").textContent)||c);$("entry").textContent=fmt(entry);$("break").textContent=fmt(br);$("sl1").textContent=fmt(sl);$("sl2").textContent=fmt(c*(1-risk*1.5));$("sl3").textContent=fmt(c*(1-risk*2));$("tp1").textContent=fmt(tp1);$("tp2").textContent=fmt(tp2);$("tp3").textContent=fmt(tp3);let rr=(tp1-c)/(c-sl);$("riskShow").textContent=fmt((c-sl)/c*100)+"%";$("reward").textContent=fmt((tp1-c)/c*100)+"%";$("rr").textContent="1 : "+fmt(rr);let judge=p>=br?"🚀 突破確認":p>=c?"🟡 成本上方，等待確認":"🔴 成本下方，暫不追價";$("judge").textContent=judge;$("judge").className="bigjudge "+(p>=br?"ok":p>=c?"warn":"err");let sc=p>=br?"🟢 劇本A：突破成功 → 續抱，若回測守住再考慮增加":p>=c?"🟡 劇本B：高檔／震盪 → 等待，不追高":"🔴 劇本C：轉弱 → 優先控制損失";$("scenario").textContent=sc;let mc=num($("mycost").value),sh=num($("shares").value);$("pnl").textContent=mc&&sh&&num($("price").textContent)!=null?fmt((num($("price").textContent)-mc)*sh)+" "+cur.currency:"--";if(t&&p) $("levels").innerHTML=[["🥜成本",c,"green"],["🌱第一關",c+(t-c)*.33,"blue"],["🌿第二關",c+(t-c)*.66,"yellow"],["🚀目標",t,"orange"]].map(x=>`<div class="rabbit ${x[2]}"><b>${x[0]}</b><strong>${fmt(x[1])}</strong>完成度 ${fmt(p/x[1]*100)}%</div>`).join("")}
async function scan(type){$("scanStatus").textContent="⏳ 掃描中，請稍候…";$("results").innerHTML="";let out=[];for(let x of lists[market]){try{let old=cur;let data=await getScan(x[0],x[1]);if(!data)continue;let p=data.p,m=data.m,a=[20,60,120,240].filter(n=>m[n]!=null&&p>=m[n]).length,near=[20,60,120,240].filter(n=>m[n]!=null&&Math.abs(p-m[n])/m[n]<=.03).length,cat=a>=3&&data.pc>=1?"break":a>=3?"strong":near>=1||a>=2?"watch":"other";if(type==="all"||cat===type)out.push({...data,cat})}catch(e){}}out.sort((a,b)=>b.pc-a.pc);$("scanStatus").textContent="🟢 掃描完成，共 "+out.length+" 檔";$("results").innerHTML=out.length?out.map(x=>`<div class="result"><b>${x.code} ${x.name}</b>　<span class="${x.pc>=0?"up":"down"}">${x.pc>=0?"+":""}${fmt(x.pc)}%</span><br>現價 ${fmt(x.p)}｜20日 ${fmt(x.m[20])}｜60日 ${fmt(x.m[60])}｜120日 ${fmt(x.m[120])}｜240日 ${fmt(x.m[240])}</div>`).join(""):"<div class='status warn'>目前沒有符合條件的資料，或資料來源暫時無法取得。</div>"}
async function getScan(c,n){if(market==="TW"){let r=await fin("TaiwanStockPrice",{data_id:c,start_date:ds(ago(500)),end_date:ds(new Date())});if(!r.length)return null;r.sort((a,b)=>String(a.date).localeCompare(String(b.date)));let p=r.at(-1).close,pr=r.length>1?r.at(-2).close:null,cl=r.map(x=>num(x.close)).filter(x=>x!=null);return{code:c,name:n,p:num(p),pc:pr?(p-pr)/pr*100:0,m:{20:avg(cl,20),60:avg(cl,60),120:avg(cl,120),240:avg(cl,240)}}}let t=market==="US"?c:market==="HK"?c+".HK":market==="JP"?c+".T":c+".KS",j=await get(Y+encodeURIComponent(t)+"?period1="+Math.floor(ago(500).getTime()/1000)+"&period2="+Math.floor(Date.now()/1000+86400)+"&interval=1d"),r=j.chart?.result?.[0];if(!r)return null;let q=r.indicators.quote[0],cl=q.close.filter(v=>v!=null).map(Number),p=cl.at(-1),pr=cl.at(-2);return{code:c,name:n,p,pc:pr?(p-pr)/pr*100:0,m:{20:avg(cl,20),60:avg(cl,60),120:avg(cl,120),240:avg(cl,240)}}}
function save(){if(!cur.code){alert("請先搜尋股票");return}let a=JSON.parse(localStorage.getItem("stocks43")||"[]");if(!a.some(x=>x.code===cur.code&&x.market===market))a.push({...cur,market});localStorage.setItem("stocks43",JSON.stringify(a));render()}
function clearAll(){localStorage.removeItem("stocks43");render()}
function render(){let a=JSON.parse(localStorage.getItem("stocks43")||"[]");$("portfolio").innerHTML=a.length?a.map((x,i)=>`<div class="pitem"><b>${x.code} ${x.name}</b><button class="black" onclick="loadSaved(${i})">查看</button></div>`).join(""):"<div class='status'>尚未儲存股票。</div>"}
async function loadSaved(i){let a=JSON.parse(localStorage.getItem("stocks43")||"[]"),x=a[i];if(!x)return;setM(x.market);$("q").value=x.code;await search()}
$("q").addEventListener("keydown",e=>{if(e.key==="Enter")search()});render();
</script>
</body>
</html>