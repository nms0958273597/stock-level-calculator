from pathlib import Path

p = Path("/mnt/data/asang-order.html")
h = p.read_text(encoding="utf-8")

# Add a clearly visible TikTok button immediately below the header.
if 'class="top-tiktok"' not in h:
    marker = '</header>'
    block = '''
<div class="top-tiktok">
  <a href="https://www.tiktok.com/@mn93195353" target="_blank" rel="noopener noreferrer">
    🎵 TikTok｜@mn93195353
  </a>
</div>
'''
    h = h.replace(marker, marker + block, 1)

css = '''
.top-tiktok{max-width:680px;margin:12px auto 0;padding:0 14px}
.top-tiktok a{display:block;text-align:center;background:#111;color:#fff;text-decoration:none;border-radius:14px;padding:14px 10px;font-size:18px;font-weight:800}
'''
if '.top-tiktok{' not in h:
    h = h.replace('</style>', css + '</style>', 1)

p.write_text(h, encoding="utf-8")
print("已把 TikTok 連結放到網站最上方，開頁面就能看到：@mn93195353")
