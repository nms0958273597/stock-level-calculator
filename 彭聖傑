levelHTML(
"redbox",
"🛡️",
"跌破防守第 "+(i+1)+" 關",
v,
"相對成本約 -"+
(
(1-v/cost)*100
)
.toFixed(2)+
"%"
)
)
.join("");


const p=
num(
current&&
current.price
);


$("levelStatus").className=
"status "+
(
p!==null&&
p>=launch
?
"ok"
:
"warn"
);


