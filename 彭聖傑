function calculateLevels(){

const cost=
num($("cost").value);

const launchPct=
num($("launchPct").value)||0.5;

const gap=
num($("gapPct").value)||0.5;

if(
cost===null||
cost<=0
){

$("levels").innerHTML="";

$("riseLevels").innerHTML="";

$("fallLevels").innerHTML="";

$("levelStatus").innerText=
"等待成本";

return;

}


const launch=
cost*
(1+launchPct/100);

let arr=[];

for(
let i=1;
i<=5;
i++
){

arr.push(
launch*
Math.pow(
1+gap/100,
i
)
);

}


$("levels").innerHTML=

levelHTML(
"green",
"🥜",
"起飛價",
launch,
"成本突破 "+
launchPct+
