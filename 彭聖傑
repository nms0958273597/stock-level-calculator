<script>

const MIS =
"https://mis.twse.com.tw/stock/api/getStockInfo.jsp";

const TWSE_PE =
"https://openapi.twse.com.tw/v1/exchangeReport/BWIBBU_ALL";

const T86 =
"https://www.twse.com.tw/rwd/zh/fund/T86";

const TWSE_STOCK =
"https://www.twse.com.tw/rwd/zh/afterTrading/STOCK_DAY_ALL";

const PROXY =
u =>
"https://corsproxy.io/?url="+
encodeURIComponent(u);


let current=null;
let timer=null;
let stockList=null;


const aliases={

"台積電":{
code:"2330",
name:"台積電",
market:"上市"
},

"台積":{
code:"2330",
name:"台積電",
market:"上市"
},

"聯電":{
code:"2303",
name:"聯電",
market:"上市"
},

"台化":{
code:"1326",
name:"台化",
market:"上市"
},

"茂迪":{
code:"6244",
name:"茂迪",
market:"上市"
},

"雙鴻":{
code:"3324",
name:"雙鴻",
market:"上櫃"
},

"力積電":{
code:"6770",
name:"力積電",
market:"上市"
},

"長榮航":{
code:"2618",
name:"長榮航",
market:"上市"
},

"驊訊":{
code:"6237",
name:"驊訊",
market:"上市"
},

"燿華":{
code:"2367",
name:"燿華",
market:"上市"
},

"華通":{
code:"2313",
name:"華通",
market:"上市"
},

"啟碁":{
code:"6285",
name:"啟碁",
market:"上市"
},

"0050":{
code:"0050",
name:"元大台灣50",
market:"上市ETF"
},

"00631L":{
code:"00631L",
name:"元大台灣50正2",
market:"上市ETF"
},

"00685L":{
code:"00685L",
name:"群益臺灣加權正2",
market:"上市ETF"
}

};


function $(id){
return document.getElementById(id)
}


function num(v){

if(
v===null||
v===undefined||
v===""
)
return null;

const x=
Number(
String(v)
.replace(/,/g,"")
.replace(/%/g,"")
);

return Number.isFinite(x)
?x
:null;

}


function money(v){

const x=num(v);

return x===null
?"--"
:x.toFixed(2);

}


function clean(s){

return String(s||"")
.replace(
/[\s　\-＿_/／（）().．。·•]/g,
""
)
.toUpperCase();

}


function codeClean(s){

return clean(s)
.replace(/[^A-Z0-9]/g,"");

}


function today(){

const d=new Date();

return d.getFullYear()+
String(d.getMonth()+1).padStart(2,"0")+
String(d.getDate()).padStart(2,"0");

}


function dateMinus(n){

const d=new Date();

d.setDate(
d.getDate()-n
);

return d.getFullYear()+
String(d.getMonth()+1).padStart(2,"0")+
String(d.getDate()).padStart(2,"0");

}


function showStatus(t,c=""){

$("status").className=
"status "+c;

$("status").innerText=t;

}


function valueFromObject(o,names){

if(!o)
return null;

for(
const n of names
){

if(
Object.prototype.hasOwnProperty.call(
o,n
)
)
return o[n];

}

const keys=
Object.keys(o);

for(
const n of names
){

const k=
keys.find(
x =>
String(x)
.replace(/\s/g,"")
.includes(
String(n)
.replace(/\s/g,"")
)
);

if(k)
return o[k];

}

return null;

}


async function getJSON(url){

for(
const u of [
url,
PROXY(url)
]
){

try{

const r=
await fetch(
u,
{
cache:"no-store"
}
);

if(!r.ok)
continue;

const t=
await r.text();

if(t)
return JSON.parse(t);

}catch(e){}

}

return null;

}


async function buildList(){

if(stockList)
return stockList;

const arr=
await getJSON(
TWSE_STOCK
);

let result=[];

if(
Array.isArray(arr)
)
arr.forEach(
x=>{

const code=
String(
x.Code||
x["證券代號"]||
""
).trim();

const name=
String(
x.Name||
x["證券名稱"]||
""
).trim();

if(code)
result.push({
code,
name,
market:"上市"
});

}
);

stockList=result;

return result;

}


async function resolve(q){

const s=clean(q);
const c=codeClean(q);

if(aliases[s])
return aliases[s];

const list=
await buildList();

const f=
list.find(
x =>
codeClean(x.code)===c
)||
list.find(
x =>
clean(x.name)===s
)||
list.find(
x =>
clean(x.name).includes(s)
);

if(f)
return f;

if(
/^[A-Z0-9]{4,8}$/.test(c)
)
return{
code:c,
name:c,
market:"上市"
};

return null;

}


async function realtime(x){

for(
const ex of [
"tse_",
"otc_"
]
){

const j=
await getJSON(
MIS+
"?ex_ch="+
ex+
encodeURIComponent(x.code)+
".tw&json=1&delay=0&_="+
Date.now()
);

const z=
j&&
Array.isArray(j.msgArray)
?
j.msgArray.find(
a =>
String(a.c)===
String(x.code)
)
:null;

if(z)
return{

code:z.c,

name:z.n,

market:
ex==="tse_"
?
(x.market||"上市")
:
"上櫃",

price:num(z.z),

prev:num(z.y),

open:num(z.o),

high:num(z.h),

low:num(z.l),

