levelHTML(
[
"blue",
"purplebox",
"gold",
"orange"
][i],
[
"🌱",
"🌿",
"🌻",
"⭐"
][i],
"關卡 "+(i+1),
v,
"上漲第 "+(i+1)+" 關"
)
)
.join("");


$("riseLevels").innerHTML=

arr
.map(
(v,i)=>
levelHTML(
[
"green",
"blue",
"purplebox",
"gold",
"orange"
][i],
"🚀",
"漲幅第 "+(i+1)+" 關",
v,
"相對成本約 "+
(
(v/cost-1)*100
)
.toFixed(2)+
"%"
)
)
.join("");


const fall=[];

for(
let i=1;
i<=5;
i++
){

