"https://www.twse.com.tw/rwd/zh/afterTrading/STOCK_DAY"+
"?date="+
ym+
"01"+
"&stockNo="+
encodeURIComponent(code)+
"&response=json&_="+
Date.now();

const j=
await getJSON(url);

if(
j&&
Array.isArray(j.data)
)
j.data.forEach(
r=>{

